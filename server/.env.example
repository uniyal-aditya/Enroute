# ==============================================================================
# ENROUTE BACKEND (FASTAPI + SQLALCHEMY) ENVIRONMENT VARIABLES
# ==============================================================================

# --- Database ---
# For local dev, SQLite works out of the box (zero configuration):
DATABASE_URL=sqlite:///./enroute.db

# For production (Supabase PostgreSQL / Railway PostgreSQL):
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# --- JWT Authentication ---
# Generate a cryptographically secure 32-byte secret key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS (Cross-Origin Resource Sharing) ---
# Comma-separated list of allowed frontend origins.
# Whitespace and trailing slashes are stripped automatically — safe to copy-paste from browser.
# In production, add your Vercel URL exactly as shown in the browser address bar (no trailing slash).
#
# IMPORTANT: Without your Vercel URL here, browser requests from the frontend will be
# blocked by CORS policy after you fix the VITE_API_BASE environment variable on Vercel.
#
# Example (update with your actual Vercel URL):
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://enroute-logistics.vercel.app
