# --- Database ---
# For local dev, SQLite works out of the box (no setup needed):
DATABASE_URL=sqlite:///./enroute.db

# For production (Supabase), use the connection string from your Supabase
# project settings -> Database -> Connection string (URI), e.g.:
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Auth ---
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,https://enroute.vercel.app
